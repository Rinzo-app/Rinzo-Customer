{
  "expo": {
    "name": "Rinzo",
    "slug": "rinzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rinzo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rinzo.app"
    },
    "android": {
      "package": "com.rinzo.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rinzo.app"
        }
      ],
      "expo-font",
      "expo-notifications",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://rinzo.app"
      },
      "eas": {
        "projectId": "56f611b2-ad34-43aa-b0e1-9366d12adc9e"
      }
    },
    "owner": "rinzoadmin"
  }
}
